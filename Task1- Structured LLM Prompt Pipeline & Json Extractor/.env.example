# =====================================================================
# API Keys Configuration
# Provide at least one API key (Google Gemini or OpenAI).
# The pipeline will automatically select the available provider.
# =====================================================================

# Google Gemini API Key (Get yours at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Get yours at https://platform.openai.com/)
OPENAI_API_KEY=your_openai_api_key_here

# Default LLM Provider: "gemini" or "openai"
DEFAULT_LLM_PROVIDER=gemini

# Default Model Overrides (Optional)
# GEMINI_MODEL=gemini-2.5-flash
# OPENAI_MODEL=gpt-4o-mini
