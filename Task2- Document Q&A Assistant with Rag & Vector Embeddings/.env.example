# =====================================================================
# API Keys Configuration for Document Q&A RAG Assistant
# Provide at least one API key (Google Gemini or OpenAI).
# If no key is set, the system uses the deterministic Local / Offline mode.
# =====================================================================

# Google Gemini API Key (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (https://platform.openai.com/)
OPENAI_API_KEY=your_openai_api_key_here

# LLM Provider: "gemini", "openai", or "local"
DEFAULT_LLM_PROVIDER=gemini

# RAG Hyperparameters
RAG_CHUNK_SIZE=750
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=3
