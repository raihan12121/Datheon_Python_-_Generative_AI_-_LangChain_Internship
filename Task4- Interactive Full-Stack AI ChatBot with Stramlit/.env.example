# =====================================================================
# API Keys Configuration for Interactive Full-Stack Streamlit AI ChatBot
# Provide at least one API key (Google Gemini or OpenAI).
# If no key is set, the application runs in local streaming mode.
# =====================================================================

# Google Gemini API Key (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (https://platform.openai.com/)
OPENAI_API_KEY=your_openai_api_key_here

# Default Provider: "gemini", "openai", or "local"
DEFAULT_LLM_PROVIDER=gemini

# Streamlit Port Configuration (Optional, default: 8501)
STREAMLIT_SERVER_PORT=8501
