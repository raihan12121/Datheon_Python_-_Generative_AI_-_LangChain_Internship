# =====================================================================
# API Keys Configuration for Multi-Tool Autonomous AI Agent
# Provide at least one API key (Google Gemini or OpenAI).
# If no key is set, the agent uses the local deterministic reasoning engine.
# =====================================================================

# Google Gemini API Key (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (https://platform.openai.com/)
OPENAI_API_KEY=your_openai_api_key_here

# Default LLM Provider: "gemini", "openai", or "local"
DEFAULT_LLM_PROVIDER=gemini

# Agent Max Iterations
AGENT_MAX_ITERATIONS=6
